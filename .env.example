# Configure these in Vercel Project Settings > Environment Variables.
# Use Supabase's project URL and publishable (anon) key; never put a service role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret API key; set only in Vercel, never in frontend code or Git.
SUPABASE_SECRET_KEY=
# Temporary random secret used only for the first administrator account.
BOOTSTRAP_ADMIN_SECRET=
